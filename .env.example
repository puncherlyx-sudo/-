# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TOTP_MASTER_KEY: ОБЯЗАТЕЛЬНЫЙ секретный мастер-ключ (минимум 32 символа) для шифрования 2FA и биржевых ключей (AES-256-GCM + HKDF).
# В production (NODE_ENV=production) сервер откажется запускаться без этого ключа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ВАЖНО: после смены ключа ранее сохранённые 2FA и API-секреты перестанут расшифровываться.
TOTP_MASTER_KEY=""

# ALLOWED_ORIGINS: Список доверенных доменов через запятую для CSRF Origin-валидации (напр. https://vernier.app)
ALLOWED_ORIGINS=""

# ALLOW_EMBED_ORIGINS: (опционально) Разрешённые домены для frame-ancestors в production (пусто = X-Frame-Options: DENY и frame-ancestors 'none')
ALLOW_EMBED_ORIGINS=""

# MAX_TESTNET_ORDER_USDT: Серверный лимит максимального объёма одного Testnet-ордера в USDT (по умолчанию 5000, макс 25000).
# Live Trade жёстко отключён на уровне сервера.
MAX_TESTNET_ORDER_USDT="5000"

# BACKUP_CODE_PEPPER: Серверный секрет (мин. 16 символов) для HMAC-SHA256 хеширования резервных кодов 2FA.
BACKUP_CODE_PEPPER=""

# GEMINI_DAILY_BUDGET: Суточный лимит обращений к Gemini API (выключатель защиты бюджета, по умолчанию 500).
GEMINI_DAILY_BUDGET="500"

# VAPID ключи и контактный адрес для Web Push-уведомлений (укажите ваш реальный mailto: или https:// домен)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# FIREBASE_PROJECT_ID: (необязательно) по умолчанию берётся из firebase-applet-config.json.
# Используется сервером для проверки токенов входа.
FIREBASE_PROJECT_ID=""

# ---------- Тарифы PRO / MAX и серверный учёт кредитов ----------
# Сервисный аккаунт Firebase (JSON одной строкой или в base64) — обязателен для серверного учёта кредитов (entitlements) и контроля подписок PRO/MAX.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Цены в USD (управляются только сервером):
PRO_PRICE_MONTH_USD="29"
PRO_PRICE_YEAR_USD="264"
MAX_X10_PRICE_MONTH_USD="79"
MAX_X10_PRICE_YEAR_USD="744"
MAX_X20_PRICE_MONTH_USD="129"
MAX_X20_PRICE_YEAR_USD="1188"
